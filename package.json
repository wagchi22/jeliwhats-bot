{
  "name": "jellywhats-bot",
  "version": "1.1.0",
  "description": "API de notificações do Jellyfin para WhatsApp",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "jellywhats-bot": "bin/jellywhats-bot.js"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "bin/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagchi22/jellywhats-bot.git"
  },
  "bugs": {
    "url": "https://github.com/wagchi22/jellywhats-bot/issues"
  },
  "homepage": "https://github.com/wagchi22/jellywhats-bot#readme",
  "keywords": [
    "jellyfin",
    "whatsapp",
    "notifications",
    "bot"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "https://github.com/Adi1231234/whatsapp-web.js/archive/85443fa4c8f86111457590dd06564c3efe0f6d1d.tar.gz"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "semantic-release": "^22.0.12"
  }
}
